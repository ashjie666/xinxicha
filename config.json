{
  "site": {
    "name": "xinxicha",
    "title": "中国游戏厂商海外信息差监控",
    "subtitle": "20 款国产游戏 × 50 个英文 SEO 关键词 · 每日巡检 · 含 P1→P2→P3 回退逻辑",
    "server_path": "/xinxicha/",
    "preview_port": 8323,
    "theme_key": "xinxicha:theme",
    "schema_version": 1
  },
  "scoring": {
    "note": "权重取规格表「回退逻辑说明」的评分权重（30/20/15/15/10/10）；规格表「MVP字段表」F13 的 5×20% 旧公式已废弃",
    "weights": {
      "trends_rise": 30,
      "reddit": 20,
      "x_official": 15,
      "supply_gap": 15,
      "cn_maturity": 10,
      "launch_window": 10
    },
    "bands": {
      "trends_7d": [[-100, -20, 0], [-20, 0, 15], [0, 5, 30], [5, 20, 60], [20, null, 100]],
      "reddit_daily": [[0, 0, 0], [1, 2, 40], [3, 5, 70], [5, null, 100]],
      "launch_window_days": [[7, 100], [30, 70], [90, 40]],
      "launch_window_fallback": { "live": 20, "unknown": 10 },
      "x_official": { "official": 100, "player_only": 60, "none": 0 }
    },
    "gap_level_to_gap_score": { "高": 9, "中": 6, "低": 2 },
    "thresholds": [[80, "抢首发攻略"], [60, "做数据表占位"], [40, "监控不投入"], [0, "暂不投入"]],
    "base_score_new_game": 20,
    "min_days_for_ranking": 3,
    "confidence_rules": {
      "高": "全部 P1 源正常",
      "中": "部分 P1 失败走 P2 回退",
      "低": "P1 全部失败仅 P3 兜底"
    }
  },
  "collection": {
    "budget_seconds": 1800,
    "network_probe_url": "https://www.reddit.com/r/gaming/search.json?q=game&limit=1",
    "network_probe_url_p2": "https://www.bing.com/news/search?q=game&format=RSS",
    "network_probe_timeout": 3,
    "request_timeout": 8,
    "min_interval_sec": 30,
    "reddit_max_attempts": 2,
    "reddit_retry_wait_sec": 90,
    "budget_reserve_sec": 120,
    "cache_ttl_hours": 12,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) xinxicha-monitor/0.1",
    "failure_policy": {
      "keep_last_value_on_single_failure": true,
      "degrade_after_consecutive_failures": 3,
      "retry_after_rate_limit_minutes": 60,
      "p1_all_dead_alert": "今日海外信号不足，建议人工复核"
    }
  },
  "discovery": {
    "enabled": true,
    "note": "新游候选发现层：复用 Bing News RSS（免凭据、stdlib 可解析），按已知厂商名与品类词检索。候选只提示、不入库、不参与评分；人工确认后才加入 data/seed_games.json。",
    "max_candidates": 40,
    "per_query_max": 8,
    "request_interval_sec": 1,
    "budget_seconds": 180,
    "targets": [
      { "label": "米哈游", "kind": "publisher", "category": "二次元开放世界", "query": "米哈游 新游 二次元" },
      { "label": "网易", "kind": "publisher", "category": "开放世界 / MMO", "query": "网易 新游 开放世界" },
      { "label": "腾讯", "kind": "publisher", "category": "综合 / 天美 / 魔方 / Level Infinite", "query": "腾讯 新游 出海" },
      { "label": "莉莉丝", "kind": "publisher", "category": "休闲 / 塔防 / SLG", "query": "莉莉丝 新游" },
      { "label": "库洛游戏", "kind": "publisher", "category": "二次元动作", "query": "库洛游戏 新游 二次元" },
      { "label": "鹰角网络", "kind": "publisher", "category": "塔防 / 二次元", "query": "鹰角网络 新游" },
      { "label": "三七互娱", "kind": "publisher", "category": "SLG", "query": "三七互娱 新游 SLG" },
      { "label": "柠檬微趣", "kind": "publisher", "category": "合成休闲", "query": "柠檬微趣 新游 合成" },
      { "label": "点点互动", "kind": "publisher", "category": "合成休闲", "query": "点点互动 新游" },
      { "label": "灵游坊", "kind": "publisher", "category": "动作 / 单机", "query": "灵游坊 新游" },
      { "label": "二次元开放世界新游", "kind": "category", "category": "二次元开放世界", "query": "二次元开放世界 新游" },
      { "label": "合成休闲出海新品", "kind": "category", "category": "合成休闲", "query": "合成休闲 手游 出海" },
      { "label": "搜打撤生存新游", "kind": "category", "category": "搜打撤生存", "query": "搜打撤 生存 新游" },
      { "label": "休闲塔防新游", "kind": "category", "category": "休闲塔防", "query": "休闲塔防 新游" },
      { "label": "SLG出海新作", "kind": "category", "category": "SLG", "query": "SLG 手游 出海 新作" }
    ]
  },
  "sources": [
    {
      "key": "trends",
      "priority": "P1",
      "label": "Google Trends",
      "weight_key": "trends_rise",
      "signal": "海外搜索热度变化",
      "fallback": "Google Search 结果数估算（P2）",
      "enabled": true,
      "mode": "optional-pytrends"
    },
    {
      "key": "reddit",
      "priority": "P1",
      "label": "Reddit",
      "weight_key": "reddit",
      "signal": "玩家讨论、问题类型",
      "fallback": "Discord 公开频道 / F5Bot（P2）",
      "enabled": true,
      "mode": "public-json-api"
    },
    {
      "key": "x_twitter",
      "priority": "P1",
      "label": "X/Twitter",
      "weight_key": "x_official",
      "signal": "官方公告、测试、维护、上线",
      "fallback": "RSS 订阅 / 厂商官网公告（P2）",
      "enabled": true,
      "mode": "rss-fallback（Bing News RSS，免凭据；P1 不可达时的 P2 回退）"
    },
    {
      "key": "search_count",
      "priority": "P2",
      "label": "Google Search 结果数",
      "weight_key": "supply_gap",
